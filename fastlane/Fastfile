# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

module Fastlane
  module Actions
    module SharedValues
      ENVIRONMENT = :ENVIRONMENT
    end
  end
end

platform :ios do

  code_signing_type = {
    "development"=> "development",
    "stage"=> "adhoc",
    "production"=> "appstore"
  }

  configuration_type = {
    "development"=> "Debug",
    "stage"=> "Release",
    "production"=> "Release"
  }

  export_method_type = {
    "development"=> "development",
    "stage"=> "ad-hoc",
    "production"=> "app-store"
  }

  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "120"

  initial_version = "0.1.0"
  project_file_path = "QuickPersonalFinance.xcodeproj"
  workspace_file_path = "QuickPersonalFinance.xcworkspace"
  scheme = "QuickPersonalFinance"
  unit_tests_scheme = "QuickPersonalFinanceTests"
  app_identifier = "org.arbridev.QuickPersonalFinance"
  provisioning_profile_development = "match Development org.arbridev.QuickPersonalFinance"
  provisioning_profile_appstore = "match AppStore org.arbridev.QuickPersonalFinance"

  before_all do |lane, options|
    lane_context[SharedValues::ENVIRONMENT] = ENV["APP_BUILD_ENVIRONMENT"]
  end

  before_each do |lane, options|
    app_store_connect_api_key
  end

  after_each do |lane, options|
    notification(subtitle: "Finished", message: "#{lane}")
  end

  error do |lane, exception, options|
    notification(subtitle: "A error occured", message: "#{lane}")
  end

  desc "Syncs certificates and provisioning profiles with match. environment: development, stage, or production (lane option, otherwise APP_BUILD_ENVIRONMENT), mapped to match types development, adhoc, and appstore. readonly defaults to true."
  lane :code_signing do |options|
    log_settings

    environment = options.fetch(:environment) {
      lane_context[SharedValues::ENVIRONMENT]
    }
    UI.user_error!("environment must be development, stage, or production") unless code_signing_type.key?(environment)

    match(
      type: code_signing_type[environment],
      readonly: options.fetch(:readonly, true)
    )
  end

  desc "Sets the Xcode build number to the latest TestFlight build plus one. Does not commit."
  lane :bump_build do |options|
    latest_testflight_build_number
    latest_build_number = lane_context[SharedValues::LATEST_TESTFLIGHT_BUILD_NUMBER]
    puts "latest_build_number: #{latest_build_number}"
    increment_build_number(
      build_number: latest_build_number + 1
    )
  end

  desc "Bumps the marketing version in the Xcode project. bump_type: patch (default), minor, or major. Does not commit."
  lane :bump_version do |options|
    latest_testflight_build_number
    latest_version_number = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION] ||= initial_version
    puts "latest_version_number: #{latest_version_number}"
    increment_version_number_in_xcodeproj(
      bump_type: options.fetch(:bump_type, "patch")
    )
  end

  desc "Writes the latest TestFlight version and build number into the Xcode project. Uses 0.1.0 when TestFlight has no version. Does not commit."
  lane :set_current_version_and_build do |options|
    latest_testflight_build_number
    latest_build_number = lane_context[SharedValues::LATEST_TESTFLIGHT_BUILD_NUMBER]
    puts "latest_build_number: #{latest_build_number}"
    latest_version_number = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION] ||= initial_version
    puts "latest_version_number: #{latest_version_number}"
    increment_build_number(
      build_number: latest_build_number
    )
    increment_version_number_in_xcodeproj(
      version_number: latest_version_number
    )
    [latest_version_number, latest_build_number]
  end

  desc "Writes the latest TestFlight version and build into the Xcode project, then commits that version bump."
  lane :commit_current_version_and_build do |options|
    (version, build) = set_current_version_and_build
    commit_version_bump(
      message: "chore: set version (#{version}), build (#{build})"
    )
  end

  desc "Creates a local git tag named with the latest TestFlight version. Uses 0.1.0 when TestFlight has no version. Optional commit pins the tag to that commit. Does not push."
  lane :tag_release do |options|
    latest_testflight_build_number
    latest_version_number = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION] ||= initial_version
    puts "latest_version_number: #{latest_version_number}"

    commit = options.fetch(:commit, nil)

    add_git_tag(
      tag: "#{latest_version_number}",
      message: "Release version #{latest_version_number}",
      commit: commit
    )
  end

  desc "Runs the QuickPersonalFinanceTests scheme."
  lane :test do
    run_tests(
      workspace: workspace_file_path,
      scheme: unit_tests_scheme
    )
  end

  desc "Builds an ipa. Configuration and export method come from APP_BUILD_ENVIRONMENT: development (Debug, development), stage (Release, ad-hoc), or production (Release, app-store). Defaults to Release and app-store."
  lane :build do |options|
    environment = lane_context[SharedValues::ENVIRONMENT]
    build_app(
      workspace: workspace_file_path,
      configuration: configuration_type[environment] ||= "Release",
      export_method: export_method_type[environment] ||= "app-store",
      export_options: {
        provisioningProfiles: {
          app_identifier => provisioning_profile_development,
          app_identifier => provisioning_profile_appstore
        }
      }
    )
  end

  desc "Captures App Store screenshots with snapshot."
  lane :screenshots do |options|
    snapshot
  end

  desc "Uploads an ipa to TestFlight."
  lane :upload do |options|
    upload_to_testflight
  end

  desc "Prints the process environment."
  private_lane :log_settings do |options|
    system('printenv')
    debug ENV
  end
end
